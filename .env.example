# Required: Claude analysis + weekly review
ANTHROPIC_API_KEY=
# Required: Tavily news search
TAVILY_API_KEY=
# Optional: Supabase prediction log (logging disabled if unset)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be set for market fetching to be enabled (markets are read via the public CLOB endpoint)
POLYMARKET_API_KEY=
# Must be "true" — only paper trading is implemented
PAPER_TRADING=
# Optional tuning (defaults in code: 500, 70, 15, 5)
STARTING_BANKROLL=
MIN_CONFIDENCE=
MIN_EDGE=
MAX_BET_PERCENT=
